{
  "expo": {
    "name": "Tayah's Tumble Tips",
    "slug": "tumble-tips",
    "scheme": "tumbletips",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#E6246E" },
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.tayahtumbletips.app" },
    "android": {
      "package": "com.tayahtumbletips.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6246E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": { "favicon": "./assets/favicon.png", "bundler": "metro" }
  }
}
