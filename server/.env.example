# Copy to .env (never commit the real one) and set these in your hosting dashboard.
NODE_ENV=production
SERVER_SECRET=            # 32+ random characters. The server refuses to start in production without it.
DB_PATH=./data.sqlite     # use a persistent disk
# Sign-in emails (Resend). Required in production, or no one can receive a code.
RESEND_API_KEY=           # from resend.com > API Keys ("Sending access" is enough)
EMAIL_FROM=               # e.g. Tayah's Tumble Tips <login@yourdomain.com>. The domain must be verified in Resend.
CHALLENGE_TZ=UTC          # DECISION NEEDED: the one time zone that decides "which day is it", e.g. Australia/Sydney
CHALLENGE_END_DAY=27      # challenge closes at the start of this December day
ADMIN_EMAILS=             # comma-separated; can see flagged scores and void them
CORS_ORIGINS=             # comma-separated web origins allowed (only needed for the web build)
# Store reviewers need a login that works without reading your email:
REVIEW_EMAIL=
REVIEW_CODE=
# The date the demo account sees, so reviewers can try the Challenge before it opens. Only that account is affected.
# REVIEW_NOW=2026-12-05T12:00:00Z
# Testing only (ignored in production): pretend it is another moment
# NOW_OVERRIDE=2026-12-05T12:00:00Z
